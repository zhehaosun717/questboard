{
  "name": "My Game",
  "port": 6097,
  "dataDir": ".questboard-data",
  "events": ".questboard-data/events.jsonl",
  "registry": ".questboard-data/registry.jsonl",
  "lockFile": ".questboard-data/dispatch.lock",
  "briefs": {
    "dispatchDirs": ["docs/briefs"],
    "ownerDirs": ["docs/design"],
    "packagePattern": "^[A-Z]+(?:-[A-Z]+)*-\\d+[A-Z]?",
    "fileListHeading": "^#{1,6}\\s*files you may (edit|touch)",
    "recentDays": 7
  },
  "reviewPages": { "dir": "docs/review" },
  "lanes": {
    "codex": {
      "run": ["node", "scripts/run-worker.mjs", "--lane", "codex", "--name", "{name}", "--brief", "{brief}", "--model", "{model}", "--variant", "{variant}", "--package", "{package}", "--", "codex", "exec", "-m", "{model}", "-"],
      "outputDir": ".questboard-data/workers/codex"
    },
    "claude": {
      "run": ["node", "scripts/run-worker.mjs", "--lane", "claude", "--name", "{name}", "--brief", "{brief}", "--model", "{model}", "--variant", "{variant}", "--package", "{package}", "--", "claude", "--print", "--model", "{model}"],
      "outputDir": ".questboard-data/workers/claude",
      "editCounter": "stream-json"
    },
    "opencode": {
      "session": { "run": ["node", "scripts/opencode-session.js", "{package} {name}"], "saveTo": ".questboard-data/workers/opencode/{name}.session" },
      "run": ["node", "scripts/run-worker.mjs", "--lane", "opencode", "--name", "{name}", "--brief", "{brief}", "--model", "{model}", "--variant", "{variant}", "--package", "{package}", "--", "opencode", "run"],
      "env": { "OC_AGENT": "{agent}" },
      "api": "http://127.0.0.1:4096",
      "deliveryDir": ".questboard-data/workers/opencode",
      "outputDir": ".questboard-data/workers/opencode",
      "serialize": true
    }
  },
  "policy": {
    "bannedModelPatterns": ["-fast(\\b|-)"],
    "bannedAgents": []
  }
}
